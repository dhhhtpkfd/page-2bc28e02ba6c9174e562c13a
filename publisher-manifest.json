x;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 10px}\n  .tag{font-size:10.5px;letter-spacing:0.08em;background:var(--violet);color:var(--white);padding:3px 7px;font-weight:700}\n  .plan-price{font-size:40px;font-weight:800;letter-spacing:-0.04em;line-height:1;margin:0}\n  .plan-price small{font-size:15px;font-weight:600;letter-spacing:0;color:var(--ink-soft)}\n  .plan-annual{margin:8px 0 0;font-size:13.5px;color:var(--ink-soft)}\n  .plan-annual b{color:var(--ink)}\n  .plan-list{list-style:none;margin:0;padding:0;display:grid;gap:8px;align-content:start}\n  .plan-list li{font-size:14.5px;padding-left:20px;position:relative}\n  .plan-list li::before{content:\"\";position:absolute;left:0;top:9px;width:8px;height:8px;background:var(--violet)}\n  .plan-cta{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:12px;align-items:center;border-top:1.5px dashed rgba(27,27,33,.3);padding-top:14px}\n  .btn{display:inline-block;border:2px solid var(--line);background:var(--white);padding:9px 16px;font-size:13.5px;font-weight:700;letter-spacing:0.02em}\n  .btn:hover{background:var(--ink);color:var(--white);border-color:var(--ink)}\n  .btn.primary{background:var(--violet);color:var(--white);border-color:var(--violet)}\n  .btn.primary:hover{background:var(--ink);border-color:var(--ink)}\n  .plan-meta{font-size:12.5px;color:var(--ink-soft);margin:0}\n\n  /* 使用说明 */\n  .steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:2px solid var(--line);background:var(--white)}\n  .step{padding:20px 20px 22px;border-right:2px solid var(--line)}\n  .step:last-child{border-right:none}\n  .step-no{font-size:11px;font-weight:800;letter-spacing:0.14em;color:var(--violet);margin:0 0 8px}\n  .step h3{margin:0 0 8px;font-size:16.5px;letter-spacing:-0.01em}\n  .step p{margin:0;font-size:14px;color:var(--ink-soft)}\n\n  /* 客户端 */\n  .clients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}\n  .client{border:2px solid var(--line);background:var(--white);padding:20px 22px 22px}\n  .client h3{margin:0 0 6px;font-size:17px}\n  .client p{margin:0 0 10px;font-size:14px;color:var(--ink-soft)}\n  .client ul{margin:0;padding-left:18px;font-size:14px}\n  .client li{margin:4px 0}\n  .client .avail{font-size:12px;letter-spacing:0.08em;font-weight:700;color:var(--violet);text-transform:uppercase;display:block;margin-bottom:8px}\n\n  /* FAQ：details 折叠 */\n  .faq{border-top:2px solid var(--line)}\n  details{border-bottom:1.5px solid rgba(27,27,33,.25)}\n  details summary{cursor:pointer;list-style:none;padding:15px 40px 15px 0;font-weight:700;font-size:15.5px;position:relative}\n  details summary::-webkit-details-marker{display:none}\n  details summary::after{content:\"+\";position:absolute;right:6px;top:50%;transform:translateY(-50%);font-size:20px;font-weight:700;color:var(--violet);line-height:1}\n  details[open] summary::after{content:\"–\"}\n  details p{margin:0 0 16px;font-size:14.5px;color:var(--ink-soft);max-width:44em}\n\n  .closing{padding:34px 0 0;font-size:14px;color:var(--ink-soft);max-width:42em}\n\n  @media (max-width:900px){\n    .shell{grid-template-columns:1fr}\n    .rail{border-right:none;border-bottom:2px solid var(--line);padding:22px 20px 20px}\n    .rail-inner{position:static}\n    .rail-brand{font-size:23px}\n    .rail-sub{margin-bottom:16px}\n    .rail-nav{display:flex;flex-wrap:wrap;gap:0 6px}\n    .rail-nav li{border:none}\n    .rail-nav a{padding:6px 0;font-size:13.5px}\n    .rail-note{margin-top:16px}\n    main{padding:24px 20px 54px}\n    .dash{grid-template-columns:repeat(2,minmax(0,1fr))}\n    .dash-cell:nth-child(2n){border-right:none}\n    .dash-cell:nth-last-child(-n+2){border-bottom:none}\n    .dash-cell.wide{grid-column:span 2}\n    .plan{grid-template-columns:1fr;padding:20px}\n    .plan.featured{box-shadow:5px 5px 0 var(--violet)}\n    .steps{grid-template-columns:1fr}\n    .step{border-right:none;border-bottom:2px solid var(--line)}\n    .step:last-child{border-bottom:none}\n    .clients{grid-template-columns:1fr}\n  }\n</style><div class=\"shell\">\n\n  <aside class=\"rail\">\n    <div class=\"rail-inner\">\n      <a class=\"rail-brand\" href=\"#top\">Candy<span>.</span></a>\n      <p class=\"rail-sub\">一份说人话的说明</p>\n      <ul class=\"rail-nav\">\n        <li><a href=\"#plans\"><em>01</em>套餐与价格</a></li>\n        <li><a href=\"#howto\"><em>02</em>怎么用起来</a></li>\n        <li><a href=\"#clients\"><em>03</em>客户端</a></li>\n        <li><a href=\"#faq\"><em>04</em>常见问题</a></li>\n      </ul>\n      <div class=\"rail-note\">\n        这里没有限时倒计时，也没有“最后 3 个名额”。慢慢看完，再决定要不要。\n      </div>\n    </div>\n  </aside>\n\n  <main id=\"top\">\n\n    <header class=\"hero\">\n      <span class=\"hero-kicker\">Candy 说明书</span>\n      <h1>Candy · 把套餐、用法和疑问<br><span class=\"thin\">摊在桌面上讲给你听</span></h1>\n      <p class=\"hero-lead\">\n        很多页面喜欢把话藏起来，让你自己找。我们反过来做：价格写清楚，权益写具体，\n        不确定的地方明说。下面这几块数据，就是这一页的全部内容。\n      </p>\n\n      <div class=\"dash\">\n        <div class=\"dash-cell\">\n          <p class=\"dash-label\">套餐档位</p>\n          <p class=\"dash-value\">3 <small>档</small></p>\n          <p class=\"dash-foot\">基础、旗舰、团队</p>\n        </div>\n        <div class=\"dash-cell\">\n          <p class=\"dash-label\">起步价</p>\n          <p class=\"dash-value\">¥15 <small>/ 月</small></p>\n          <p class=\"dash-foot\">按年付 ¥150</p>\n        </div>\n        <div class=\"dash-cell accent\">\n          <p class=\"dash-label\">多数人选择</p>\n          <p class=\"dash-value\">旗舰版</p>\n          <p class=\"dash-foot\">¥35 / 月，年付 ¥350</p>\n        </div>\n        <div class=\"dash-cell\">\n          <p class=\"dash-label\">同时在线的设备</p>\n          <p class=\"dash-value\">3–20 <small>台</small></p>\n          <p class=\"dash-foot\">按套餐档位不同</p>\n        </div>\n\n        <div class=\"dash-cell wide\">\n          <p class=\"dash-label\">流量额度分布</p>\n          <p class=\"dash-value\">100 <small>GB</small> → 1000 <small>GB</small></p>\n          <div class=\"bar\"><i></i></div>\n          <p class=\"dash-foot\">基础 100GB／旗舰 300GB／团队 1000GB，均为每月额度</p>\n        </div>\n        <div class=\"dash-cell\">\n          <p class=\"dash-label\">付费周期</p>\n          <p class=\"dash-value\">月付 · 年付</p>\n          <p class=\"dash-foot\">年付为月付价 × 10</p>\n        </div>\n        <div class=\"dash-cell\">\n          <p class=\"dash-label\">页面阅读时长</p>\n          <p class=\"dash-value\">约 4 <small>分钟</small></p>\n          <p class=\"dash-foot\">读完再决定也不迟</p>\n        </div>\n      </div>\n    </header>\n\n    <section id=\"plans\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">01</span>\n        <h2>套餐与价格</h2>\n      </div>\n      <p class=\"sec-intro\">\n        三档套餐，从轻量用到团队用。年付就是把月付价乘以十，没有绕弯的算法。\n        下面的权益逐条列出，你可以直接对照自己的使用习惯挑。\n      </p>\n\n      <article class=\"plan\">\n        <div>\n          <p class=\"plan-name\">基础版</p>\n          <p class=\"plan-price\">¥15<small> / 月</small></p>\n          <p class=\"plan-annual\">按年付 <b>¥150 / 年</b></p>\n        </div>\n        <ul class=\"plan-list\">\n          <li>每月 100GB 流量额度</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>基础流媒体解锁</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"plan-cta\">\n          <a class=\"btn\" href=\"#faq\">先看看常见问题</a>\n          <p class=\"plan-meta\">适合一个人、设备不多、日常轻度使用。</p>\n        </div>\n      </article>\n\n      <article class=\"plan featured\">\n        <div>\n          <p class=\"plan-name\">旗舰版 <span class=\"tag\">多数人选择</span></p>\n          <p class=\"plan-price\">¥35<small> / 月</small></p>\n          <p class=\"plan-annual\">按年付 <b>¥350 / 年</b></p>\n        </div>\n        <ul class=\"plan-list\">\n          <li>每月 300GB 流量额度</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n        <div class=\"plan-cta\">\n          <a class=\"btn primary\" href=\"#howto\">看看怎么开始</a>\n          <p class=\"plan-meta\">手机、平板、电脑一起用的话，这一档通常更顺手。</p>\n        </div>\n      </article>\n\n      <article class=\"plan\">\n        <div>\n          <p class=\"plan-name\">团队版</p>\n          <p class=\"plan-price\">¥85<small> / 月</small></p>\n          <p class=\"plan-annual\">按年付 <b>¥850 / 年</b></p>\n        </div>\n        <ul class=\"plan-list\">\n          <li>每月 1000GB 流量额度</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"plan-cta\">\n          <a class=\"btn\" href=\"#clients\">查看客户端说明</a>\n          <p class=\"plan-meta\">小团队共用，或者设备数量明显偏多的情况。</p>\n        </div>\n      </article>\n    </section>\n\n    <section id=\"howto\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">02</span>\n        <h2>怎么用起来</h2>\n      </div>\n      <p class=\"sec-intro\">\n        三步，没有隐藏关卡。如果你在中间卡住了，FAQ 里大概率已经有答案。\n      </p>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <p class=\"step-no\">STEP 01</p>\n          <h3>先想清楚你要用多少</h3>\n          <p>\n            一个人刷网页、看视频，基础版就够；如果家里几台设备轮着用，或者常在游戏里对延迟敏感，\n            再往上选一档更合适。别为了便宜硬压需求。\n          </p>\n        </div>\n        <div class=\"step\">\n          <p class=\"step-no\">STEP 02</p>\n          <h3>选周期，然后配置</h3>\n          <p>\n            月付适合先试试手感，年付相当于付十个月。选定后按页面提示完成配置，\n            你会拿到对应的接入信息，请自己妥善保存。\n          </p>\n        </div>\n        <div class=\"step\">\n          <p class=\"step-no\">STEP 03</p>\n          <h3>在客户端里填入并连接</h3>\n          <p>\n            挑一个你顺手的客户端，把接入信息填进去，连接成功后先打开一个网页确认。\n            多数问题都出在复制时多了空格。\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">03</span>\n        <h2>客户端</h2>\n      </div>\n      <p class=\"sec-intro\">\n        我们不在这一页直接给下载按钮，因为客户端由各自的开发者维护，版本更新也由他们决定。\n        下面按平台说明该找什么、该注意什么。具体地址以你所用平台的官方发布页为准。\n      </p>\n      <div class=\"clients\">\n        <div class=\"client\">\n          <span class=\"avail\">桌面端</span>\n          <h3>Windows / macOS</h3>\n          <p>适合固定在家里或办公室使用，配置一次后长期不动。</p>\n          <ul>\n            <li>选择仍在维护、近期有更新记录的客户端</li>\n            <li>安装后先确认系统代理是否被正确设置</li>\n            <li>公司电脑涉及权限时，先问过管理员</li>\n          </ul>\n        </div>\n        <div class=\"client\">\n          <span class=\"avail\">移动端</span>\n          <h3>Android / iOS</h3>\n          <p>出门在外用得最多的场景，切换网络时偶尔需要重连。</p>\n          <ul>\n            <li>iOS 上可选的客户端相对有限，安装前看清说明</li>\n            <li>Android 若提示来源不明，属正常现象，请自行判断风险</li>\n            <li>移动网络与 Wi-Fi 之间切换后，建议手动确认状态</li>\n          </ul>\n        </div>\n        <div class=\"client\">\n          <span class=\"avail\">路由器</span>\n          <h3>路由器 / 局域网设备</h3>\n          <p>想让电视、游戏机这类不方便装客户端的设备也能用，可以考虑这一种。</p>\n          <ul>\n            <li>需要设备本身支持相应插件或配置方式</li>\n            <li>配置后全屋设备共用同一个在线数，注意套餐上限</li>\n            <li>改动前建议备份原配置，出问题好回退</li>\n          </ul>\n        </div>\n        <div class=\"client\">\n          <span class=\"avail\">使用提醒</span>\n          <h3>几条通用建议</h3>\n          <p>不管用哪个客户端，下面这些习惯能省掉不少麻烦。</p>\n          <ul>\n            <li>接入信息不要发到公开群里，也不要截图外传</li>\n            <li>同时在线设备数以套餐说明为准，超了会互相挤掉</li>\n            <li>遇到连不上，先换一个节点试，再排查本地网络</li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">04</span>\n        <h2>常见问题</h2>\n      </div>\n      <p class=\"sec-intro\">\n        我们把被问得最多的几件事整理在这里。点开看答案，没找到的可以走工单。\n      </p>\n\n      <div class=\"faq\">\n        <details>\n          <summary>年付是怎么算的，真的划算吗？</summary>\n          <p>\n            年付价格就是月付价乘以十，比如基础版 ¥15／月，年付 ¥150。也就是说一年里有两个月是省下来的，\n            算法直接写在这里，没有额外的折扣规则需要你去猜。\n          </p>\n        </details>\n\n        <details>\n          <summary>流量用超了会怎样？</summary>\n          <p>\n            每档套餐都有对应的每月额度：基础版 100GB、旗舰版 300GB、团队版 1000GB。\n            额度按月计算。如果你发现自己经常接近上限，说明该往上调一档了，而不是硬撑。\n          </p>\n        </details>\n\n        <details>\n          <summary>我能不能在手机上和朋友共用一份？</summary>\n          <p>\n            每档套餐的在线设备数是固定的：3 台、5 台、20 台。共用意味着这些设备共享同一个额度，\n            也共享同一个在线数上限，超出时会被挤下线。是否合适，取决于你们的使用强度。\n          </p>\n        </details>\n\n        <details>\n          <summary>旗舰版里的 IPLC 专线和普通线路差在哪？</summary>\n          <p>\n            旗舰版包含 IPLC 专线相关的游戏加速优化，基础版使用的是普通线路节点池。\n            如果你主要是在意游戏时的连接体验，这一项值得考虑；如果只是日常浏览，\n            两者的差别未必明显。\n          </p>\n        </details>\n\n        <details>\n          <summary>遇到问题，多久能有人回复？</summary>\n          <p>\n            旗舰版包含 7×24 优先工单支持，团队版配有专属客户经理。基础版同样可以通过工单反馈，\n            但优先级不同。提交时把现象、设备和已尝试的步骤写清楚，能省掉一轮来回。\n          </p>\n        </details>\n\n        <details>\n          <summary>我该选哪一档？</summary>\n          <p>\n            一个人、设备两三台、偶尔看视频，选基础版；手机平板电脑一起用、对游戏延迟有要求，\n            选旗舰版；如果是一小队人共用，或者设备数量明显偏多，选团队版。\n            拿不准就先按月付试一档，不合适再调整。\n          </p>\n        </details>\n\n        <details>\n          <summary>客户端在哪里下载？</summary>\n          <p>\n            这一页不提供下载地址。客户端由各自的开发者维护，我们无法保证某个链接长期有效，\n            所以更建议你去对应平台的官方发布页或应用商店确认最新版本，再看清说明后安装。\n          </p>\n        </details>\n\n        <details>\n          <summary>换了设备，原来的配置还能用吗？</summary>\n          <p>\n            配置文件本身不绑定某台机器，但同时在线的设备数量受套餐限制。\n            换设备时把旧设备断开，再在新设备上填入原配置即可。接入信息请自己保管好，不要外传。\n          </p>\n        </details>\n      </div>\n\n      <p class=\"closing\">\n        Candy 想做的事很简单：把该说的说完，把不该承诺的咽回去。\n        如果这一页还有哪里没说清楚，那多半是我们的问题，欢迎通过工单告诉我们。\n      </p>\n    </section>\n\n  </main>\n</div>",
